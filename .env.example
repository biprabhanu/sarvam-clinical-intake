# Sarvam AI (server-side only)
SARVAM_API_KEY=

# Shared passcode gate (required in production)
APP_PASSCODE=
# Random string, 32+ characters, used to sign the login cookie
SESSION_SECRET=

# Private Vercel Blob store — added automatically when you connect the store on Vercel.
# Leave unset locally to store data on disk in data/.
BLOB_READ_WRITE_TOKEN=

# Optional overrides
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
